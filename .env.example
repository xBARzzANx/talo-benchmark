# Anthropic (Claude Haiku 4.5 + Sonnet 4.5 as Gold Standard)
ANTHROPIC_API_KEY=sk-ant-...

# OpenAI (GPT-4.1-mini)
OPENAI_API_KEY=sk-...

# Google AI Studio (Gemini 2.5 Flash)
GOOGLE_API_KEY=AIza...

# Ollama (local — no key needed, just the base URL)
OLLAMA_BASE_URL=http://localhost:11434

# LLM-as-Judge model (set after deciding which model to use)
JUDGE_MODEL=claude-sonnet-4-20250514

# Experiment config
TEMPERATURE=0.0
MAX_TOKENS=2048
LOG_LEVEL=INFO
